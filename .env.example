# No accounts or AI keys needed for mock mode.
TRAVEL_PROVIDER=mock
DUFFEL_ACCESS_TOKEN=
TRAVEL_DATABASE=data/travel.sqlite3
# Optional local bearer key. Not a substitute for multi-user authentication.
TRAVEL_API_KEY=
MAX_PROVIDER_CALLS_PER_TRIP=12
MAX_PROVIDER_CALLS_PER_DAY=60
MAX_DATE_OPTIONS=3
MAX_CONCURRENT_PROVIDER_CALLS=2
PROVIDER_TIMEOUT_SECONDS=12
CACHE_TTL_SECONDS=120
# Enable supplier-result retention only after confirming contractual permission.
ALLOW_SUPPLIER_CACHE=false
